generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

// ─── Auth ────────────────────────────────────────────────────────────────────

model User {
  id         Int        @id @default(autoincrement())
  username   String?    @unique              // local users set this; OAuth users may not
  name       String
  email      String?    @unique              // populated from OAuth; optional for local
  role       String     @default("user")
  emailVerifiedAt DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @default(now()) @updatedAt

  identities  Identity[]
  memberships Membership[]
  authTokens  AuthToken[]
  externalAuthTransactions ExternalAuthTransaction[]
  cartItems  CartItem[]
  orders     Order[]
  reviews    Review[]
  wishlists  Wishlist[]

  @@map("users")
}

model Identity {
  id          Int      @id @default(autoincrement())
  userId      Int
  provider    String   // 'local' | 'email' | 'google' | 'telegram' | 'github'
  providerId  String   // username/email for first-party providers; sub/id for OAuth
  credentials Json     @default("{}")
  // local:    { "hash": "$2b$..." }
  // external providers: adapter-owned credentials; never expose them through API
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  lastUsedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@map("identities")
}

// ─── Identity / SaaS tenancy ──────────────────────────────────────────────────

model Organization {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  plan        String       @default("free")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  memberships Membership[]

  @@map("organizations")
}

model Membership {
  id             String       @id @default(cuid())
  organizationId String
  userId         Int
  role           String       @default("owner")
  status         String       @default("active")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("memberships")
}

model AuthToken {
  id         String    @id @default(cuid())
  userId     Int?
  email      String?
  type       String    // 'magic_login' | 'account_link' | future verification flows
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email, type])
  @@index([userId, type])
  @@map("auth_tokens")
}

model ExternalAuthTransaction {
  id         String    @id @default(cuid())
  provider   String
  stateHash  String    @unique
  userId     Int?
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([provider, expiresAt])
  @@index([consumedAt])
  @@map("external_auth_transactions")
}

// Managed by connect-pg-simple; mapped here so Prisma db push never drops sessions.
model Session {
  sid    String   @id @db.VarChar
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)

  @@index([expire], map: "IDX_session_expire")
  @@map("session")
}

// ─── Catalogue ───────────────────────────────────────────────────────────────

model Product {
  id          Int        @id @default(autoincrement())
  name        String
  description String
  price       Int
  category    String
  image       String
  stock       Int        @default(0)
  material    String     @default("Premium Grade")
  warranty    String     @default("Lifetime")
  origin      String     @default("Studio Crafted")
  assembly    String     @default("White Glove")
  colors      String[]   @default([])
  cartItems   CartItem[]
  reviews     Review[]
  wishlists   Wishlist[]

  @@map("products")
}

// ─── Commerce ────────────────────────────────────────────────────────────────

model CartItem {
  id        Int     @id @default(autoincrement())
  userId    Int
  productId Int
  quantity  Int     @default(1)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("cart_items")
}

model Order {
  id        Int         @id @default(autoincrement())
  userId    Int
  total     Int
  status    String      @default("Processing")
  address   String      @default("")
  createdAt DateTime    @default(now())
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     OrderItem[]

  @@map("orders")
}

model OrderItem {
  id        Int    @id @default(autoincrement())
  orderId   Int
  productId Int
  name      String
  price     Int
  quantity  Int
  image     String
  order     Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_items")
}

model Wishlist {
  id        Int      @id @default(autoincrement())
  userId    Int
  productId Int
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("wishlists")
}

model Review {
  id        Int      @id @default(autoincrement())
  productId Int
  userId    Int
  rating    Int
  body      String?
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, userId])
  @@map("reviews")
}

// ─── Marketing ───────────────────────────────────────────────────────────────

model Newsletter {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  createdAt DateTime @default(now())

  @@map("newsletters")
}
