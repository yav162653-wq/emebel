generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

// ─── Auth ────────────────────────────────────────────────────────────────────

model User {
  id         Int        @id @default(autoincrement())
  username   String?    @unique              // local users set this; OAuth users may not
  name       String
  email      String?    @unique              // populated from OAuth; optional for local
  role       String     @default("user")
  createdAt  DateTime   @default(now())

  identities Identity[]
  cartItems  CartItem[]
  orders     Order[]
  reviews    Review[]
  wishlists  Wishlist[]

  @@map("users")
}

model Identity {
  id          Int      @id @default(autoincrement())
  userId      Int
  provider    String   // 'local' | 'google' | 'telegram' | 'github'
  providerId  String   // username for local; sub/id for OAuth providers
  credentials Json     @default("{}")
  // local:    { "hash": "$2b$..." }
  // google:   { "accessToken": "...", "refreshToken": "..." }
  // telegram: { "telegramId": 123456 }
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@map("identities")
}

// ─── Catalogue ───────────────────────────────────────────────────────────────

model Product {
  id          Int        @id @default(autoincrement())
  name        String
  description String
  price       Int
  category    String
  image       String
  stock       Int        @default(0)
  material    String     @default("Premium Grade")
  warranty    String     @default("Lifetime")
  origin      String     @default("Studio Crafted")
  assembly    String     @default("White Glove")
  colors      String[]   @default([])
  cartItems   CartItem[]
  reviews     Review[]
  wishlists   Wishlist[]

  @@map("products")
}

// ─── Commerce ────────────────────────────────────────────────────────────────

model CartItem {
  id        Int     @id @default(autoincrement())
  userId    Int
  productId Int
  quantity  Int     @default(1)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("cart_items")
}

model Order {
  id        Int         @id @default(autoincrement())
  userId    Int
  total     Int
  status    String      @default("Processing")
  address   String      @default("")
  createdAt DateTime    @default(now())
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     OrderItem[]

  @@map("orders")
}

model OrderItem {
  id        Int    @id @default(autoincrement())
  orderId   Int
  productId Int
  name      String
  price     Int
  quantity  Int
  image     String
  order     Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_items")
}

model Wishlist {
  id        Int      @id @default(autoincrement())
  userId    Int
  productId Int
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("wishlists")
}

model Review {
  id        Int      @id @default(autoincrement())
  productId Int
  userId    Int
  rating    Int
  body      String?
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, userId])
  @@map("reviews")
}

// ─── Marketing ───────────────────────────────────────────────────────────────

model Newsletter {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  createdAt DateTime @default(now())

  @@map("newsletters")
}
