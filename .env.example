NODE_ENV=development
PORT=5000

DATABASE_URL=postgresql://emebel_app:replace-me@localhost:5432/emebel
# Set MIGRATION_DATABASE_URL only in the migration job/shell, never in the app environment.
# MIGRATION_DATABASE_URL=postgresql://emebel_migrator:replace-me@localhost:5432/emebel
SESSION_SECRET=replace-with-a-random-32-plus-character-secret
APP_ORIGIN=http://localhost:5000
LOG_LEVEL=info
METRICS_TOKEN=

AUTH_EMAIL_FROM=
AUTH_MAGIC_LINK_TTL_MINUTES=15
RESEND_API_KEY=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
TELEGRAM_CLIENT_ID=
TELEGRAM_CLIENT_SECRET=

SHOPIFY_SHOP_DOMAIN=
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_SYNC_NAMES=

OTEL_SERVICE_NAME=emebel
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_TRACES_EXPORTER=

# Demo data is disabled unless both backend and local-database guards allow it.
SEED_DEMO_DATA=false
VITE_ENABLE_DEMO_DATA=false
